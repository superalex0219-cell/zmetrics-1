# ─────────────────────────────────────────────────────────────────────────────
# ZMetrics — environment template
# Copy to infra/.env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=zmetrics
POSTGRES_USER=zmetrics
POSTGRES_PASSWORD=changeme

# Keycloak admin
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin123
KC_REALM=zmetrics
KC_CLIENT_ID=zmetrics-backend

# --- Admin user management via the Keycloak Admin API (ADMIN-USERS-1) ---
# When ENABLE_ADMIN_USER_MANAGEMENT=true, the backend creates/updates Keycloak users
# and resets passwords using the `zmetrics-backend` service account (client_credentials).
# Requirements when enabling:
#   * KC_CLIENT_ID MUST be the service-account-enabled client `zmetrics-backend`
#     (NOT a public client) - that client holds the realm-management roles.
#   * KC_CLIENT_SECRET MUST match the `zmetrics-backend` client secret in the realm
#     (see infra/keycloak/realm-export.json -> clients[].secret). Never commit a real
#     secret; this placeholder only works against the dev realm export.
ENABLE_ADMIN_USER_MANAGEMENT=false
KC_CLIENT_SECRET=changeme-replace-in-production

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET_FRAMES=zmetrics-frames
MINIO_BUCKET_ARTIFACTS=zmetrics-artifacts

# Celery worker
WORKER_CONCURRENCY=2

# SAM3 segmentation model
# Set SAM3_WEIGHTS_DIR to the directory where bodhicitta/sam3 weights are stored locally.
# Download: python -c "from huggingface_hub import snapshot_download; snapshot_download('bodhicitta/sam3', local_dir='../models/sam3', ignore_patterns=['sam3.pt'])"
# Real SAM3 inference (needs GPU overlay: docker-compose.gpu.yml). false = mock masks.
ENABLE_SAM3=false
SAM3_WEIGHTS_DIR=../models/sam3
SAM3_MODEL_PATH=/models/sam3
SAM3_TEXT_PROMPT=rock fragment
SAM3_CONFIDENCE_THRESHOLD=0.5

# Set to true to use OpenCV StereoSGBM instead of mock depth estimation.
# Requires both left_frame and right_frame artifacts in each CaptureSession.
ENABLE_REAL_STEREO=false

# --- LLM explanation layer (M5-b) ---
# Optional Claude-generated prose for recommendation_text. When disabled (or no
# key) the worker falls back to the deterministic M5-a rule text. Advisory only:
# never auto-applies parameters; badge + review footer are always enforced.
# Never commit a real key - leave ANTHROPIC_API_KEY blank here.
ENABLE_LLM_RECOMMENDATIONS=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=512
