# Copy this file to .env and fill in real values before running.
# Never commit .env to git.

# PostgreSQL
POSTGRES_DB=zmetrics
POSTGRES_USER=zmetrics
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_FRAMES=zmetrics-frames
MINIO_BUCKET_ARTIFACTS=zmetrics-artifacts

# Keycloak OIDC
KC_DB_PASSWORD=changeme
KC_ADMIN=admin
KC_ADMIN_PASSWORD=changeme
KC_REALM=zmetrics
KC_CLIENT_ID=zmetrics-backend
KC_CLIENT_SECRET=changeme
KEYCLOAK_URL=http://keycloak:8080

# Backend
DATABASE_URL=postgresql+asyncpg://zmetrics:changeme@postgres:5432/zmetrics
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]

# Worker
WORKER_CONCURRENCY=2
